{
  "name": "product-knowledge-base",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @pkb/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @pkb/db generate",
    "db:migrate": "pnpm --filter @pkb/db migrate",
    "db:studio": "pnpm --filter @pkb/db studio",
    "seed": "tsx scripts/seed-sample-data.ts",
    "eval:search": "tsx scripts/evaluate-search.ts"
  },
  "devDependencies": {
    "@pkb/db": "workspace:*",
    "@pkb/ingest": "workspace:*",
    "@pkb/search": "workspace:*",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@9.15.0"
}
